<%- include('../partials/header', { title, section: 'service-requests' }) %>

<div class="mb-5 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold">Service Request Management</h1>
  <a class="btn btn-primary" href="/service-requests/new">Submit Service Request</a>
</div>

<%- include('../partials/notice', { notice, error }) %>

<form class="panel mb-5 !p-4" method="get" action="/service-requests" role="search">
  <div class="flex flex-wrap items-end gap-3">
    <div class="min-w-0 flex-1 basis-64">
      <label class="mb-1.5 block text-sm font-semibold" for="search">Search by service type or description</label>
      <input class="input" id="search" name="search" type="search" value="<%= search %>" placeholder="e.g. clearance">
    </div>
    <div class="basis-44">
      <label class="mb-1.5 block text-sm font-semibold" for="status">Status</label>
      <select class="input" id="status" name="status">
        <option value="">All Statuses</option>
        <% statusOptions.forEach((option) => { %>
          <option value="<%= option %>" <%= status === option ? 'selected' : '' %>><%= option %></option>
        <% }) %>
      </select>
    </div>
    <div class="flex gap-2">
      <button class="btn" type="submit">Search</button>
      <% if (search.trim().length > 0 || status.length > 0) { %>
        <a class="btn btn-link" href="/service-requests">Clear</a>
      <% } %>
    </div>
  </div>
</form>

<% if (serviceRequests.length === 0) { %>
  <p class="rounded-xl border border-dashed border-gray-300 bg-white px-4 py-10 text-center text-gray-500">No Service Requests found.</p>
<% } else { %>
  <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-600">
        <tr>
          <th scope="col" class="px-4 py-3">ID</th>
          <th scope="col" class="px-4 py-3">Resident ID</th>
          <th scope="col" class="px-4 py-3">Service Type</th>
          <th scope="col" class="px-4 py-3">Description</th>
          <th scope="col" class="px-4 py-3">Date Requested</th>
          <th scope="col" class="px-4 py-3">Status</th>
          <th scope="col" class="px-4 py-3">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 [&_td]:px-4 [&_td]:py-3 [&_td]:align-middle">
        <% serviceRequests.forEach(({ serviceRequest, actions }) => { %>
          <tr class="hover:bg-gray-50" data-service-request-id="<%= serviceRequest.id %>">
            <td class="text-gray-500"><%= serviceRequest.id %></td>
            <td><%= serviceRequest.residentId %></td>
            <td><%= serviceRequest.serviceType %></td>
            <%# long descriptions are visually shortened; the full text is on the details page %>
            <td class="max-w-xs truncate" title="<%= serviceRequest.description %>"><%= serviceRequest.description %></td>
            <td class="whitespace-nowrap"><%= serviceRequest.dateRequested %></td>
            <td class="whitespace-nowrap"><%- include('../partials/status-badge', { status: serviceRequest.status }) %></td>
            <td>
              <div class="flex gap-2 whitespace-nowrap">
                <a class="btn btn-sm" href="/service-requests/<%= serviceRequest.id %>">View</a>
                <%- include('_actions', { serviceRequest, actions, small: true }) %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
