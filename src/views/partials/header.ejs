<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - CSMS</title>

  <%# Tailwind CSS browser build: no npm install or build step required %>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.3"></script>
  <style type="text/tailwindcss">
    @layer components {
      .btn { @apply inline-flex items-center rounded-lg border border-gray-300 bg-white px-3.5 py-2 text-sm font-medium text-gray-800 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500; }
      .btn-primary { @apply border-blue-700 bg-blue-700 text-white hover:bg-blue-800; }
      .btn-link { @apply border-transparent bg-transparent text-blue-700 hover:bg-blue-50; }
      .btn-sm { @apply px-2.5 py-1 text-xs; }
      .badge { @apply inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold; }
      .badge-active { @apply bg-green-100 text-green-800; }
      .badge-inactive { @apply bg-gray-200 text-gray-700; }
      .input { @apply w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30; }
      .panel { @apply rounded-xl border border-gray-200 bg-white p-6 shadow-sm; }
    }
  </style>
</head>
<body class="min-h-screen bg-gray-100 text-gray-900 antialiased">
  <header class="bg-gray-900">
    <div class="mx-auto flex max-w-6xl items-center gap-6 px-4 py-3">
      <a class="font-extrabold tracking-wider text-white" href="/">CSMS</a>
      <nav aria-label="Main">
        <a class="text-sm text-gray-200 hover:text-white" href="/residents">Resident Management</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 py-6">
