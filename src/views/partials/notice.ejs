<% if (locals.notice) { %>
  <div class="mb-5 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-green-800" role="status"><%= notice %></div>
<% } %>
<% if (locals.error) { %>
  <div class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-800" role="alert"><%= error %></div>
<% } %>
