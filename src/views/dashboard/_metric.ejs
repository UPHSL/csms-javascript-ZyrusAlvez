<%# one summary card: the label and number are plain text; color only supplements them %>
<% const content = `
  <dt class="text-xs font-semibold uppercase tracking-wide ${locals.emphasis ? 'text-blue-800' : 'text-gray-500'}">${label}</dt>
  <dd class="mt-1 text-3xl font-bold tabular-nums" data-metric="${metric}">${value}</dd>`; %>
<% if (locals.href) { %>
  <a href="<%= href %>" class="block rounded-xl border p-4 shadow-sm hover:border-blue-400 <%= locals.emphasis ? 'border-blue-200 bg-blue-50' : 'border-gray-200 bg-white' %>">
    <div><%- content %></div>
  </a>
<% } else { %>
  <div class="rounded-xl border p-4 shadow-sm <%= locals.emphasis ? 'border-blue-200 bg-blue-50' : 'border-gray-200 bg-white' %>"><%- content %></div>
<% } %>
